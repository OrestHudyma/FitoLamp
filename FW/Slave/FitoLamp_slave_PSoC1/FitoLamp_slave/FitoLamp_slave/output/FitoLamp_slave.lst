0B45: 60 26    MOV   REG[0x26],A        (0328)    mov   reg[PWM16_CH0_COMPARE_MSB_REG], A       ;
0B47: 52 01    MOV   A,[X+1]            (0329)    mov   A, [X+bOrigCompareValue+1]                 ; Restore the Compare LSB register
0B49: 60 22    MOV   REG[0x22],A        (0330)    mov   reg[PWM16_CH0_COMPARE_LSB_REG], A       ;
