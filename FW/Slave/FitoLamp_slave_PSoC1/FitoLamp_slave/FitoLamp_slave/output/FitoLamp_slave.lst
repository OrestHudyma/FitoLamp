0AC9: 5D 2E    MOV   A,REG[0x2E]        (0310)    mov   A, reg[PWM16_CH1_COMPARE_MSB_REG]       ; Save the Compare register on the stack
0ACB: 08       PUSH  A                  (0311)    push  A                                          ;
0ACC: 5D 2A    MOV   A,REG[0x2A]        (0312)    mov   A, reg[PWM16_CH1_COMPARE_LSB_REG]       ;
0ACE: 08       PUSH  A                  (0313)    push  A                                          ;  -stack frame now 2 bytes-
0ACF: 41 2B FE AND   REG[0x2B],0xFE     
0AD2: 71 10    OR    F,0x10             
                                        (0314)    PWM16_CH1_Stop_M                              ; Disable the PWM function
                                        (0315)    M8C_SetBank1                                     ;
0AD4: 5D 29    MOV   A,REG[0x29]        (0316)    mov   A, reg[PWM16_CH1_INPUT_LSB_REG]         ; save the LSB clock input setting
0AD6: 08       PUSH  A                  (0317)    push  A                                          ;   on the stack (now 3 bytes) and ...
                                        (0318)                                                     ;   hold the clock low:
0AD7: 62 29 00 MOV   REG[0x29],0x0      (0319)    mov   reg[PWM16_CH1_INPUT_LSB_REG], INPUT_REG_NULL
0ADA: 70 EF    AND   F,0xEF             
                                        (0320)    M8C_SetBank0                                     ; Extract the Count via DR2 register
0ADC: 5D 2C    MOV   A,REG[0x2C]        (0321)    mov   A, reg[PWM16_CH1_COUNTER_MSB_REG]       ; DR2 <- DR0 (in the MSB block)
0ADE: 5D 2E    MOV   A,REG[0x2E]        (0322)    mov   A, reg[PWM16_CH1_COMPARE_MSB_REG]       ; Stash the Count MSB on the stack
0AE0: 08       PUSH  A                  (0323)    push  A                                          ;  -stack frame is now 4 bytes
0AE1: 5D 28    MOV   A,REG[0x28]        (0324)    mov   A, reg[PWM16_CH1_COUNTER_LSB_REG]       ; DR2 <- DR0 (in the LSB block)
0AE3: 5D 2A    MOV   A,REG[0x2A]        (0325)    mov   A, reg[PWM16_CH1_COMPARE_LSB_REG]       ; Stash the Count LSB on the stack
0AE5: 08       PUSH  A                  (0326)    push  A                                          ;   -stack frame is now 5 bytes-
0AE6: 52 00    MOV   A,[X+0]            (0327)    mov   A, [X+bOrigCompareValue]                   ; Restore the Compare MSB register
0AE8: 60 2E    MOV   REG[0x2E],A        (0328)    mov   reg[PWM16_CH1_COMPARE_MSB_REG], A       ;
0AEA: 52 01    MOV   A,[X+1]            (0329)    mov   A, [X+bOrigCompareValue+1]                 ; Restore the Compare LSB register
0AEC: 60 2A    MOV   REG[0x2A],A        (0330)    mov   reg[PWM16_CH1_COMPARE_LSB_REG], A       ;
0AEE: 71 10    OR    F,0x10             
                                        (0331)    M8C_SetBank1                                     ; ---Restore the PWM operation
0AF0: 52 02    MOV   A,[X+2]            (0332)    mov   A, [X+bOrigClockSetting]                   ; Grab the LSB clock setting...
0AF2: 60 29    MOV   REG[0x29],A        (0333)    mov   reg[PWM16_CH1_INPUT_LSB_REG], A         ;    and restore it
0AF4: 70 EF    AND   F,0xEF             
0AF6: 43 2B 01 OR    REG[0x2B],0x1      
                                        (0334)    M8C_SetBank0                                     ;
                                        (0335)    PWM16_CH1_Start_M                             ; Now re-enable the PWM function
0AF9: 18       POP   A                  (0336)    pop   A                                          ; Setup the return value
0AFA: 20       POP   X                  (0337)    pop   X                                          ;
0AFB: 38 FD    ADD   SP,0xFD            (0338)    ADD   SP, -(STACK_FRAME_SIZE-2)                  ; Zap remainder of stack frame
0AFD: 70 3F    AND   F,0x3F             
0AFF: 71 C0    OR    F,0xC0             
                                        (0339)    RAM_EPILOGUE RAM_USE_CLASS_2
0B01: 7F       RET                      (0340)    ret
                                        (0341) 
