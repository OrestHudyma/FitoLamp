0B39: 5D 24    MOV   A,REG[0x24]        (0321)    mov   A, reg[PWM16_CH0_COUNTER_MSB_REG]       ; DR2 <- DR0 (in the MSB block)
0B3B: 5D 26    MOV   A,REG[0x26]        (0322)    mov   A, reg[PWM16_CH0_COMPARE_MSB_REG]       ; Stash the Count MSB on the stack
0B3D: 08       PUSH  A                  (0323)    push  A                                          ;  -stack frame is now 4 bytes
0B3E: 5D 20    MOV   A,REG[0x20]        (0324)    mov   A, reg[PWM16_CH0_COUNTER_LSB_REG]       ; DR2 <- DR0 (in the LSB block)
