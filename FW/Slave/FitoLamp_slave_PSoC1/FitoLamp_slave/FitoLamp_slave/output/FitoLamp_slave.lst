0B26: 5D 26    MOV   A,REG[0x26]        (0310)    mov   A, reg[PWM16_CH0_COMPARE_MSB_REG]       ; Save the Compare register on the stack
0B28: 08       PUSH  A                  (0311)    push  A                                          ;
0B29: 5D 22    MOV   A,REG[0x22]        (0312)    mov   A, reg[PWM16_CH0_COMPARE_LSB_REG]       ;
0B2B: 08       PUSH  A                  (0313)    push  A                                          ;  -stack frame now 2 bytes-
0B2C: 41 23 FE AND   REG[0x23],0xFE     
0B2F: 71 10    OR    F,0x10             
                                        (0314)    PWM16_CH0_Stop_M                              ; Disable the PWM function
                                        (0315)    M8C_SetBank1                                     ;
0B31: 5D 21    MOV   A,REG[0x21]        (0316)    mov   A, reg[PWM16_CH0_INPUT_LSB_REG]         ; save the LSB clock input setting
0B33: 08       PUSH  A                  (0317)    push  A                                          ;   on the stack (now 3 bytes) and ...
                                        (0318)                                                     ;   hold the clock low:
0B34: 62 21 00 MOV   REG[0x21],0x0      (0319)    mov   reg[PWM16_CH0_INPUT_LSB_REG], INPUT_REG_NULL
0B37: 70 EF    AND   F,0xEF             
